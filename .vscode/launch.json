{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AIParseQuestionService (8080)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"],
      "cwd": "${workspaceFolder}/core/src/Services/AIParseQuestionService",
      "python": "${workspaceFolder}/core/src/Services/AIParseQuestionService/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "AIGradingService (8081)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8081", "--reload"],
      "cwd": "${workspaceFolder}/core/src/Services/AIGradingService",
      "python": "${workspaceFolder}/core/src/Services/AIGradingService/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Run AI Services",
      "configurations": [
        "AIParseQuestionService (8080)",
        "AIGradingService (8081)"
      ],
      "stopAll": true
    }
  ]
}
