# Required
OPENAI_API_KEY=sk-...
INTERNAL_API_KEY=your-internal-api-key

# OpenAI models
OPENAI_MODEL_T1=gpt-4o-mini
OPENAI_MODEL_T2=gpt-4o
LLM_TIMEOUT_SECONDS=120

# Confidence & scoring
CONFIDENCE_THRESHOLD=0.6
VISION_CONFIDENCE_PENALTY=0.85

# Redis (suggestion cache)
REDIS_URL=redis://:rootpassword@localhost:6380/1

# RabbitMQ (event backbone — consume AiGradeRequested, publish AiGradeCompleted/Failed)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USERNAME=root
RABBITMQ_PASSWORD=rootpassword
RABBITMQ_VHOST=/
# Set to false to run HTTP-only (no background worker), e.g. for isolated tests
RABBITMQ_CONSUMER_ENABLED=true

# Observability (opt-in) — export traces to the OpenTelemetry collector
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Service
PORT=8081
MAX_CONCURRENT_LLM=10
CACHE_TTL_SECONDS=604800
