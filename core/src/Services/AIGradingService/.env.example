# Required
OPENAI_API_KEY=sk-...
INTERNAL_API_KEY=your-internal-api-key

# OpenAI models
OPENAI_MODEL_T1=gpt-4o-mini
OPENAI_MODEL_T2=gpt-4o
LLM_TIMEOUT_SECONDS=120

# Confidence & scoring
CONFIDENCE_THRESHOLD=0.6
VISION_CONFIDENCE_PENALTY=0.85

# Redis (suggestion cache)
REDIS_URL=redis://:rootpassword@localhost:6380/1

# GradingService write-back
GRADING_SERVICE_BASE_URL=http://localhost:5058

# Service
PORT=8081
MAX_CONCURRENT_LLM=10
CACHE_TTL_SECONDS=604800
