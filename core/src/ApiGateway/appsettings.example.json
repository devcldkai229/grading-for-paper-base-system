{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "change-me-long-random-string",
    "Issuer": "IamService",
    "Audience": "GradingSystem"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "iam-public-route": {
        "ClusterId": "iam-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "catalog-semesters-route": {
        "ClusterId": "exam-catalog-cluster",
        "AuthorizationPolicy": "requireAuth",
        "Match": { "Path": "/api/semesters/{**catch-all}" }
      },
      "catalog-exams-route": {
        "ClusterId": "exam-catalog-cluster",
        "AuthorizationPolicy": "requireAuth",
        "Match": { "Path": "/api/exams/{**catch-all}" }
      },
      "catalog-subjects-route": {
        "ClusterId": "exam-catalog-cluster",
        "AuthorizationPolicy": "requireAuth",
        "Match": { "Path": "/api/subjects/{**catch-all}" }
      },
      "submission-route": {
        "ClusterId": "submission-cluster",
        "AuthorizationPolicy": "requireAuth",
        "Match": { "Path": "/api/submissions/{**catch-all}" }
      },
      "grading-route": {
        "ClusterId": "grading-cluster",
        "AuthorizationPolicy": "requireAuth",
        "Match": { "Path": "/api/grading/{**catch-all}" }
      },
      "reporting-route": {
        "ClusterId": "reporting-cluster",
        "AuthorizationPolicy": "requireAuth",
        "Match": { "Path": "/api/reports/{**catch-all}" }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "requireAuth",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "iam-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5055/" }
        }
      },
      "exam-catalog-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5056/" }
        }
      },
      "submission-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5057/" }
        }
      },
      "grading-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5058/" }
        }
      },
      "reporting-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5059/" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5060/" }
        }
      }
    }
  }
}
