# GradePaper — copy to .env and fill in real values
# ASP.NET Core: nested keys use double underscore, e.g. JwtSettings__Secret

# ── Shared JWT ──
JwtSettings__Secret=change-me-long-random-string
JwtSettings__Issuer=IamService
JwtSettings__Audience=GradingSystem

# ── PostgreSQL ──
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=gradepaper_identity;Username=postgres;Password=your-password

# ── MongoDB (SubmissionService) ──
SubmissionDatabase__ConnectionString=mongodb://localhost:27018
SubmissionDatabase__DatabaseName=gradepaper_submission

# ── AWS S3 ──
AwsS3__Region=ap-southeast-1
AwsS3__BucketName=your-bucket-name
AwsS3__AccessKey=your-access-key
AwsS3__SecretKey=your-secret-key
AwsS3__ForcePathStyle=false
AwsS3__PresignedUrlTtlMinutes=10

# ── RabbitMQ ──
RabbitMq__Host=localhost
RabbitMq__Port=5673
RabbitMq__Username=root
RabbitMq__Password=your-password

# ── Redis ──
Redis__ConnectionString=localhost:6380,password=your-password

# ── Service URLs ──
AiGradingServiceUrl=http://localhost:8081
AiParseQuestionServiceUrl=http://localhost:8080

# ── AI grading (Python) ──
OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL: rubric grid extraction (AIParseQuestionService)
OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL_T1/T2: grading tiers (AIGradingService)
OPENAI_MODEL_T1=gpt-4o-mini
OPENAI_MODEL_T2=gpt-4o
INTERNAL_API_KEY=change-me-internal-api-key
InternalAuth__ApiKey=change-me-internal-api-key
GRADING_SERVICE_BASE_URL=http://localhost:5058

# ── API Gateway ──
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173
RateLimiting__PermitLimit=100
RateLimiting__WindowSeconds=60

# ── Google OAuth (IamService) ──
GoogleAuth__ClientId=your-google-client-id.apps.googleusercontent.com
